  "fixed_sql": [
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"opening_balance\" INTEGER NOT NULL DEFAULT 0, \"color\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"system_key\" TEXT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"wallet_id\" TEXT NOT NULL REFERENCES wallets (id), \"to_wallet_id\" TEXT NULL REFERENCES wallets (id), \"category_id\" TEXT NULL REFERENCES categories (id), \"note\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"category_id\" TEXT NOT NULL REFERENCES categories (id), \"amount\" INTEGER NOT NULL, \"start_month\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "journal_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"journal_entries\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"entry_date\" TEXT NOT NULL, \"entry_time\" TEXT NULL, \"mood\" INTEGER NULL, \"title\" TEXT NULL, \"body\" TEXT NULL, \"tags\" TEXT NULL, \"audio_path\" TEXT NULL, \"audio_duration_ms\" INTEGER NULL, \"audio_transcript\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_dirty\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_dirty\" IN (0, 1)), \"entry_id\" TEXT NULL REFERENCES journal_entries (id), \"transaction_id\" TEXT NULL REFERENCES transactions (id), \"local_path\" TEXT NULL, \"remote_key\" TEXT NULL, \"mime_type\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
